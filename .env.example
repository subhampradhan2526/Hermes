# ==========================================
# FOOTBALL AI ANALYTICS PLATFORM CONFIGURATION
# ==========================================

# API Settings
HOST=0.0.0.0
PORT=8000
DEBUG=True
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000

# Next.js Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000

# Database
# Local SQLite default (switches to postgresql+asyncpg://user:pass@localhost:5432/football_ai for production)
DATABASE_URL=sqlite+aiosqlite:///./backend/storage/football_ai.db
SYNC_DATABASE_URL=sqlite:///./backend/storage/football_ai.db

# Storage Paths
STORAGE_PATH=./backend/storage
UPLOADS_PATH=./backend/storage/uploads
PROCESSED_PATH=./backend/storage/processed
REPORTS_PATH=./backend/storage/reports

# Existing Computer Vision Models
PLAYER_MODEL_PATH=./examples/soccer/data/football-player-detection.pt
BALL_MODEL_PATH=./examples/soccer/data/football-ball-detection.pt
PITCH_MODEL_PATH=./examples/soccer/data/football-pitch-detection.pt
SAMPLE_VIDEO_PATH=./examples/soccer/data/2e57b9_0.mp4

# Device: 'mps' for Apple Silicon, 'cuda' for NVIDIA, 'cpu' fallback
DEVICE=mps

# Custom Model Adapter Settings (Optional)
MODEL_BASE_URL=
MODEL_ENDPOINT=
MODEL_API_KEY=
MODEL_TIMEOUT=120
DEFAULT_MODEL=existing_pipeline
